static int acousticFrames(const char* input,size_t bytes,double rate,double pitch,double* output,size_t capacityFrames,size_t* requiredFrames,size_t* leadingPauseFrames,size_t* trailingPauseFrames,bool english){
    if(!input||!requiredFrames||(!output&&capacityFrames)||bytes>65536||!tvx::isfinite(rate)||!tvx::isfinite(pitch)||rate<.1||rate>10||pitch<=0||pitch>10)return -1;
    TVOX_TRY{auto phrases=acousticPhrases(decode(input,bytes),english);auto seg=segments(phrases,rate*ADAM_RATE,english);size_t total=0;for(auto& s:seg){total+=s.n;if(total>500000)return -1;}auto track=tracks(seg);auto f0=pitchTrack(seg,phrases,pitch,english);auto frames=buildFrames(seg,track,f0,english);*requiredFrames=frames.size();if(leadingPauseFrames)*leadingPauseFrames=seg.front().n;if(trailingPauseFrames)*trailingPauseFrames=seg.size()>1?seg.back().n:0;if(capacityFrames<frames.size())return 1;for(size_t i=0;i<frames.size();++i)for(size_t j=0;j<28;++j)output[i*28+j]=frames[i][j];return 0;}TVOX_CATCH}
extern "C" int tvox_pl_frames(const char* input,size_t bytes,double rate,double pitch,double* output,size_t capacityFrames,size_t* requiredFrames){return tvox_pl_frames_ex(input,bytes,rate,pitch,output,capacityFrames,requiredFrames,nullptr,nullptr);}

extern "C" int tvox_pl_frames_ex(const char* p,size_t n,double rate,double pitch,double* out,size_t cap,size_t* count,size_t* lead,size_t* tail){return acousticFrames(p,n,rate,pitch,out,cap,count,lead,tail,false);}
extern "C" int tvox_en_frames_ex(const char* p,size_t n,double rate,double pitch,double* out,size_t cap,size_t* count,size_t* lead,size_t* tail){return acousticFrames(p,n,rate,pitch,out,cap,count,lead,tail,true);}
