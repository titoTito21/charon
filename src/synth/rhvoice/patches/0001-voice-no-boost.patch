 namespace RHVoice
 {
+  namespace
+  {
+    // Charon port: lower-case the name (classic locale) and replace '-'
+    // with '_', as the Boost string algorithms did (the only Boost use in
+    // the core), so the core builds without Boost.
+    std::string make_voice_id(const std::string& name)
+    {
+      std::string id;
+      for(char c: name)
+        id.push_back(c=='-'?'_':std::tolower(c, std::locale::classic()));
+      return id;
+    }
+  }
