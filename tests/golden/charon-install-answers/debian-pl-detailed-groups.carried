==== /var/lib/charon/answers.env ====
# Charon: answers of the detailed mode that differ from the defaults. Read by personal.sh.
charon_path='d'
charon_user='jan'
charon_ssh='no'
formats='en_GB'
ntp='no'
sudo_nopw='yes'
shell='zsh'
groups='dialout'
grub_wait='5'
grub_tune='off'
boot_text='yes'
sd_rate='25'
sd_punct='all'
braille='auto'
braille_table='pl'
flatpak='yes'
firewall='on'
sets='everyday'

==== a saved answer set (without the system's main questions) ====
[charon-answers]
format=1
made=charon-r410

[plan]
version=1
name=host-test
systems=debian
mode=detailed

[system.debian]
kind=debian
formats=en_GB
ntp=no
sudo_nopw=yes
shell=zsh
groups=dialout
grub_wait=5
grub_tune=off
boot_text=yes
sd_rate=25
sd_punct=all
braille=auto
braille_table=pl
flatpak=yes
firewall=on
sets=everyday

[secrets]
