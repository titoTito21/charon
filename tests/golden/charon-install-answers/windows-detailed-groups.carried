==== \charon\answers.ini ====
; Charon: answers of the detailed mode that differ from the defaults. Read by Charon-Personal.ps1.
wtimezone=Central European Standard Time
w_bootmenu=tile
w_hibernate=off
fast_startup=off
w_punct=200
w_layout=laptop
w_modifier=extended,capslock
w_nvda_stats=yes
w_update=3
w_display_off=1
w_lid=0
w_features=wsl

==== a saved answer set (without the system's main questions) ====
[charon-answers]
format=1
made=charon-r410

[plan]
version=1
name=host-test
systems=windows
mode=detailed

[system.windows]
kind=windows
wtimezone=Central European Standard Time
w_bootmenu=tile
w_hibernate=off
fast_startup=off
w_punct=200
w_layout=laptop
w_modifier=extended,capslock
w_nvda_stats=yes
w_update=3
w_display_off=1
w_lid=0
w_features=wsl

[secrets]
