# Written by Charon: the guided installation only brings Charon along.
d-i preseed/early_command string (sh /charon/progress.sh watch /target </dev/null >/dev/null 2>&1 3>&- 4>&- 5>&- 6>&- &)
d-i preseed/late_command string : > /tmp/charon-watch-stop; mkdir -p /target/boot/efi/EFI/HAK /target/var/lib/charon; cp -r /charon/EFI/HAK/. /target/boot/efi/EFI/HAK/; cp /charon/install-charon.sh /charon/goodbye.wav /charon/progress.sh /charon/charon-tone /target/var/lib/charon/; chmod 755 /target/var/lib/charon/charon-tone; cp /charon/voice.conf /target/var/lib/charon/ 2>/dev/null; in-target sh /var/lib/charon/install-charon.sh || true; if [ -f /charon/network.conf ]; then cp /charon/network.sh /charon/network.conf /target/var/lib/charon/; chmod 600 /target/var/lib/charon/network.conf; in-target sh /var/lib/charon/network.sh apply || true; fi; /charon/charon-tone -p 100 784 110 0 30 1175 170 || true
